# =============================================================================
# hack-vp-user — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Usado por: Docker Compose, Docker (--env-file), AWS Fargate (task definition)
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados — MySQL
# Fargate: valores injetados automaticamente via SSM Parameter Store no CI/CD
#   SSM /hack-vp/sandbox/rds/endpoint  → host do RDS
#   SSM /hack-vp/sandbox/rds/port      → porta (ex: 3306)
#   SSM /hack-vp/sandbox/rds/database  → nome do banco (ex: video_auth)
#   SSM /hack-vp/sandbox/rds/username  → usuário
#   SSM /hack-vp/sandbox/rds/password  → senha (SecureString)
# Docker Compose: use o nome do serviço (mysql)
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:mysql://mysql:3306/video_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DATABASE_USER=vpuser
DATABASE_PASSWORD=root

# -----------------------------------------------------------------------------
# JWT — Cognito
# Fargate: valores injetados automaticamente via SSM Parameter Store no CI/CD
#   SSM /hack-vp/sandbox/cognito/user-pool-id → Cognito User Pool ID
#   SSM /hack-vp/sandbox/cognito/region       → região AWS do User Pool
#   SSM /hack-vp/sandbox/cognito/jwt-secret   → App Client Secret (SecureString)
# JWT_ISSUER é montado como: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-super-secret-key-min-32-chars
JWT_ISSUER=auth-service

# -----------------------------------------------------------------------------
# JVM (opcional)
# Ajuste conforme o tamanho da task no Fargate (ex: 512 MB → -Xmx384m)
# -----------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx512m

# -----------------------------------------------------------------------------
# AWS — Obrigatório
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
ACCESS_KEY=
ACCESS_SECRET=
AWS_SESSION_TOKEN=
